# Database Configuration
# For local MySQL: mysql://root:password@localhost:3306/kds_lab
# For PlanetScale: mysql://user:password@aws.connect.psdb.cloud/dbname?sslaccept=strict
# For Railway: mysql://user:password@hostname:port/dbname
DATABASE_URL=mysql://user:password@localhost:3306/kds_lab

# NextAuth Configuration
# Base URL of your application
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Must be at least 32 characters in production
NEXTAUTH_SECRET=your-secret-key-min-32-chars-change-in-prod

# Seed Script Configuration (optional)
SEED_ADMIN_EMAIL=admin@lab.local
SEED_ADMIN_PASSWORD=demo123
